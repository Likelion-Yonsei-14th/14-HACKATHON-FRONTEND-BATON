{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/data/**",
              "components/forms/**",
              "components/navigation/**",
              "components/patterns/**",
              "ui_kits/workspace/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Outfit|DM Mono))/i]",
        "message": "Font not provided by the design system. Available: Outfit, DM Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|ring|status|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, ring, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:online|away|busy)$/]",
        "message": "<Avatar> status must be one of 'online' | 'away' | 'busy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarStack'] > JSXAttribute > JSXIdentifier[name!=/^(?:people|size|max|overlap|key|ref|className|style|children)$/]",
        "message": "<AvatarStack> doesn't accept that prop. Declared props: people, size, max, overlap."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|leadingSlot|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconRight, leadingSlot, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|quiet|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'quiet' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CallTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|width|muted|onEnd|key|ref|className|style|children)$/]",
        "message": "<CallTile> doesn't accept that prop. Declared props: src, name, width, muted, onEnd."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|notch|notchAction|notchSize|pad|interactive|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, notch, notchAction, notchSize, pad, interactive."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|raised|accent|inverse|glass)$/]",
        "message": "<Card> tone must be one of 'paper' | 'raised' | 'accent' | 'inverse' | 'glass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeltaBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|key|ref|className|style|children)$/]",
        "message": "<DeltaBadge> doesn't accept that prop. Declared props: value."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocThumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|title|caption|width|key|ref|className|style|children)$/]",
        "message": "<DocThumb> doesn't accept that prop. Declared props: src, title, caption, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|search|sort|key|ref|className|style|children)$/]",
        "message": "<FilterBar> doesn't accept that prop. Declared props: options, value, onChange, search, sort."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|iconColor|active|onClick|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: children, icon, iconColor, active, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|tone|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, tone, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|light|muted|faint|hot|danger)$/]",
        "message": "<Icon> tone must be one of 'ink' | 'light' | 'muted' | 'faint' | 'hot' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|variant|size|dot|label|onClick|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, variant, size, dot, label, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:quiet|dark|accent|danger|glass|outline)$/]",
        "message": "<IconButton> variant must be one of 'quiet' | 'dark' | 'accent' | 'danger' | 'glass' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|key|ref|className|style|children)$/]",
        "message": "<IconRail> doesn't accept that prop. Declared props: items, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='InterestRamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|steps|label|size|key|ref|className|style|children)$/]",
        "message": "<InterestRamp> doesn't accept that prop. Declared props: level, steps, label, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='LeadCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|photo|sources|interest|interestLabel|tone|onOpen|key|ref|className|style|children)$/]",
        "message": "<LeadCard> doesn't accept that prop. Declared props: name, role, photo, sources, interest, interestLabel, tone, onOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='LeadCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|raised|accent)$/]",
        "message": "<LeadCard> tone must be one of 'paper' | 'raised' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|delta|size|key|ref|className|style|children)$/]",
        "message": "<MetricStat> doesn't accept that prop. Declared props: value, label, delta, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScheduleBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|date|slots|onOpen|key|ref|className|style|children)$/]",
        "message": "<ScheduleBar> doesn't accept that prop. Declared props: label, date, slots, onOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|width|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: placeholder, value, onChange, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|count|countLabel|right|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: title, count, countLabel, right."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|options|avatar|onChange|tone|width|key|ref|className|style|children)$/]",
        "message": "<SelectPill> doesn't accept that prop. Declared props: value, options, avatar, onChange, tone, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:raised|chip)$/]",
        "message": "<SelectPill> tone must be one of 'raised' | 'chip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SourceTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<SourceTag> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SummaryPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|blocks|width|key|ref|className|style|children)$/]",
        "message": "<SummaryPanel> doesn't accept that prop. Declared props: title, blocks, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:person|title|kindIcon|meta|attendees|status|statusOptions|tone|primaryAction|onNotify|key|ref|className|style|children)$/]",
        "message": "<TaskCard> doesn't accept that prop. Declared props: person, title, kindIcon, meta, attendees, status, statusOptions, tone, primaryAction, onNotify."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:raised|paper|accent)$/]",
        "message": "<TaskCard> tone must be one of 'raised' | 'paper' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:stops|active|key|ref|className|style|children)$/]",
        "message": "<TimelineRail> doesn't accept that prop. Declared props: stops, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|mark|text|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, tone, mark, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|light)$/]",
        "message": "<Wordmark> tone must be one of 'ink' | 'light'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
